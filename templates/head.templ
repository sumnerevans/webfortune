package templates

import "strconv"

templ styles() {
	<style>
		@font-face {
			font-family: "Iosevka";
			font-style: normal;
			font-display: swap;
			font-weight: 400;
			src: url(https://cdn.jsdelivr.net/fontsource/fonts/iosevka@latest/latin-400-normal.woff2) format("woff2"),
				url(https://cdn.jsdelivr.net/fontsource/fonts/iosevka@latest/latin-400-normal.woff) format("woff");
		}

		body {
			font-family: Iosevka, monospace;
		}

		.quote-wrapper {
			min-width: max-content;
			max-width: max-content;

			.quote {
				width: 79ch;
			}
		}

		.quote figcaption {
			color: #adb5bd;
		}

		.quote-action-button {
			width: 2.25rem;
			height: 2.25rem;
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}

		.quote-action-button.btn-lg {
			width: 3rem;
			height: 3rem;
		}
	</style>
}

templ head(goatcounterDomain, description, canonicalURL, imageURL string, imageWidth, imageHeight int, imageAlt string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="theme-color" content="#000000"/>
		<meta name="description" content={ description }/>
		<title>Web Fortune</title>
		<link rel="canonical" href={ canonicalURL }/>
		<meta property="og:title" content="Web Fortune"/>
		<meta property="og:type" content="website"/>
		<meta property="og:url" content={ canonicalURL }/>
		<meta property="og:description" content={ description }/>
		<meta property="og:site_name" content="Web Fortune"/>
		<meta property="og:image" content={ imageURL }/>
		<meta property="og:image:type" content="image/png"/>
		<meta property="og:image:width" content={ strconv.Itoa(imageWidth) }/>
		<meta property="og:image:height" content={ strconv.Itoa(imageHeight) }/>
		<meta property="og:image:alt" content={ imageAlt }/>
		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
			rel="stylesheet"
			integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
			crossorigin="anonymous"
		/>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/fork-awesome@1.2.0/css/fork-awesome.min.css"
			integrity="sha256-XoaMnoYC5TH6/+ihMEnospgm0J1PM/nioxbOUdnM8HY="
			crossorigin="anonymous"
		/>
		@styles()
		<script src="https://unpkg.com/htmx.org@1.9.8" integrity="sha384-rgjA7mptc2ETQqXoYC3/zJvkU7K/aP44Y+z7xQuJiVnB/422P/Ak+F/AqFR7E4Wr" crossorigin="anonymous"></script>
		if goatcounterDomain != "" {
			<script data-goatcounter={ goatcounterDomain } async src="https://gc.zgo.at/count.js"></script>
		}
	</head>
}
